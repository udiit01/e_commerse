New-Item -Path .gitignore -ItemType File

# Virtual environments
venv/
venv312/
venv313/

# Environment variables / secrets
.env
*.env

# Python cache
__pycache__/
*.py[cod]
*$py.class

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Build files
build/
dist/
*.egg-info/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/